# Neon PostgreSQL (BKS uygulamasıyla aynı veritabanı)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require&channel_binding=require

# Google Drive service account — tam JSON string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Shared Drive resource key (current season klasörü için)
GOOGLE_DRIVE_RESOURCE_KEY=0-MKTgAd4XnpTp7S5flJBKuA

# Hangi klasör senkronize edilecek: current | 2025-2026 | 2024-2025 | 2023-2024 | 2022-2023 | 2021-2022
SYNC_FOLDER_KEY=current

# archive-full: değişmemiş dosyaları da zorla işle (arşiv one-time sync için)
# normal: sadece değişen dosyaları işle (varsayılan)
SYNC_MODE=normal

# Loglama seviyesi
LOG_LEVEL=info
