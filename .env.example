# Neon PostgreSQL (BKS uygulamasıyla aynı veritabanı)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require&channel_binding=require

# Google Drive service account — tam JSON string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Shared Drive resource key (current season klasörü için)
GOOGLE_DRIVE_RESOURCE_KEY=0-MKTgAd4XnpTp7S5flJBKuA

# TBF/FIBA/Milli maçları (TBL, EuroLeague, BGL, BSL, KBSL, FIBA BCL/EuroCup vb.) — Drive
# değil, iki canlı Google E-Tablosu. bks-web-system reposundaki OAuth hesabıyla AYNI
# (lib/google-oauth.ts) — Sheets okuma yetkisi olan tek kimlik o. .env.local'dan kopyala.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Sheet ID'leri secret değil (link ile görüntülemeye açık), ama env'den okunuyor
# (CLAUDE.md: config koda gömülmez).
TBF_MILLI_CURRENT_SHEET_ID=13vqGkED9g946sOTu6YvPDkpbOru3NvXMRWKA10KkInc
TBF_MILLI_ARCHIVE_SHEET_ID=1yyONb3WuR_ySyOZ_7SQ9HfAWl3-mZqC5KV9CXEnsZ5k

# Hangi klasör senkronize edilecek: current | 2025-2026 | 2024-2025 | 2023-2024 | 2022-2023 | 2021-2022
SYNC_FOLDER_KEY=current

# archive-full: değişmemiş dosyaları da zorla işle (arşiv one-time sync için)
# normal: sadece değişen dosyaları işle (varsayılan)
SYNC_MODE=normal

# Loglama seviyesi
LOG_LEVEL=info
